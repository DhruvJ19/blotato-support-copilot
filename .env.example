# Copy to .env for local experiments. Never commit a real key.
# The app reads the environment. It does not load this file on its own.

# Live reads (list accounts, post status, failed-post list).
BLOTATO_API_KEY=

# Optional. scripts/smoke_readonly looks up this submission when set.
BLOTATO_SUBMISSION_ID=

# Set to 1 to use the recorded fixtures and skip the network.
# Mock wins over a real key so a demo cannot hit production by accident.
BLOTATO_MOCK=

# Optional override. Default is https://backend.blotato.com/v2
BLOTATO_API_BASE_URL=
